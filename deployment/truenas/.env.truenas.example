# =============================================================================
# Release100 TrueNAS SCALE (ElectricEel-24.10.0.2) Environment Template
# Copyright 2026 Mahendra GURAV | Apache License 2.0
# [CODE-MARKER: TN-ENV-01]
#
# Copy to /mnt/tank/apps/release100/config/.env on your TrueNAS host.
# Never commit real production secrets to Git.
# =============================================================================

# ── 1. Container Registry & Image Versioning ──────────────────────────────────
GHCR_REGISTRY=ghcr.io/meetmahendra
IMAGE_TAG=latest

# ── 2. TrueNAS ZFS Dataset Root Path ──────────────────────────────────────────
TRUENAS_APPDATA_ROOT=/mnt/tank/apps/release100

# ── 3. Host Ports on TrueNAS LAN ──────────────────────────────────────────────
CORE_HOST_PORT=8000
MAIL_HOST_PORT=8001
TEMP_HOST_PORT=8002
OPS_HOST_PORT=8010

# ── 4. Shared Platform Database (Default Mode 1: Single Shared DB) ────────────
POSTGRES_DB=release100
POSTGRES_USER=release100
POSTGRES_PASSWORD=mock_postgres_password_12345
DATABASE_URL=postgresql+psycopg2://release100:mock_postgres_password_12345@postgres-shared:5432/release100

# ── 5. Optional Per-Cartridge Dedicated Databases (Mode 2 & Mode 3 Override) ──
# Leave blank to share DATABASE_URL across Core and all Cartridges.
# Set any of these to isolate a specific cartridge onto its own RDBMS/SQLite DB:
CORE_DATABASE_URL=
OPS_DATABASE_URL=
CARTRIDGE_DB_URL_MAIL_ORGANIZER=
CARTRIDGE_DB_URL_TEMPERATURE_MARKER=

# ── 6. Safety & Execution Mode (GEES v3.1 Fail-Safe Defaults) ─────────────────
DRY_RUN=true
EXECUTION_MODE=shadow

# ── 7. Security, AI & WhatsApp Cloud API Placeholders (Replace on TrueNAS) ────
GEMINI_API_KEY=mock_gemini_test_key_12345
JWT_SECRET_KEY=test_jwt_secret_98765
BIOMETRIC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WHATSAPP_VERIFY_TOKEN=apex_verify_token_2026
WHATSAPP_APP_SECRET=mock_whatsapp_app_secret_12345
WHATSAPP_ACCESS_TOKEN=mock_whatsapp_access_token_abcdef
WHATSAPP_PHONE_NUMBER_ID=123456789012345
CLOUDFLARE_TUNNEL_TOKEN=mock_cloudflare_tunnel_token_12345
