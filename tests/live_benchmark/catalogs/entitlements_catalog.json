      "is_safety_critical": true,
      "input": {
        "groups": [
          {
            "name": "g1",
            "kind": "USER",
            "members": [
              "alice"
            ],
            "bindings": [
              {
                "app_id": "mail_organizer",
                "bundle_id": "inbox_user",
                "scope": "TENANT",
                "unit": null,
                "confirm": false
              }
            ]
          }
        ],
        "principal": "alice",
        "auth_strategy": "api_key",
        "action_id": "mail:inbox:view",
        "mode": "enforce"
      },
      "expected": {
        "allowed": false,
        "reason": "NO_MATCHING_BINDING"
      }
    },
    {
      "id": "ENT-012",
      "name": "Unmapped MCP tool denied under enforce when onboarded",
