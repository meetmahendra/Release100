# ============================================================================
# Release100 — Master Platform Configuration Template
# Copyright 2026 Mahendra GURAV | Apache License 2.0
#
# USAGE:
#   Copy this file to .env in the repository root and fill in your values.
#   NEVER commit .env to Git — it is listed in .gitignore.
#
# SAFETY DEFAULT: DRY_RUN=True prevents all destructive actions until
# explicitly set to False after production readiness verification.
# ============================================================================

# ─────────────────────────────────────────────
# OPERATIONAL IDENTITY & MULTI-KIOSK FLEET
# ─────────────────────────────────────────────
ORGANIZATION_NAME=Canectar Foods Pvt Ltd
STATION_NAME=Kiosk #04 (Phoenix Mall)
KIOSK_ID=CANEBOT-PUNE-04
TENANT_ID=canectar_foods

# ─────────────────────────────────────────────
# ACTIVE APPLICATION CARTRIDGES
# Change to enable/disable domain apps at runtime.
# ─────────────────────────────────────────────
ENABLED_APPLICATIONS=["temperature_marker","mail_organizer"]

# ─────────────────────────────────────────────
# SAFETY & EXECUTION MODE (GEES v1.0)
# DRY_RUN=True  → Shadow mode: no mutations, no external calls
# DRY_RUN=False → Assistive or Autonomous mode (set EXECUTION_MODE)
# ─────────────────────────────────────────────
DRY_RUN=True
EXECUTION_MODE=shadow
CONFIDENCE_THRESHOLD=0.85

# ─────────────────────────────────────────────
# SERVER PORTS
# ─────────────────────────────────────────────
ORCHESTRATOR_PORT=8002
MCP_SERVER_PORT=8001

# ─────────────────────────────────────────────
# GOOGLE GEMINI LLM GATEWAY
# ─────────────────────────────────────────────
GEMINI_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ROUTING_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
DEFAULT_LLM_PROVIDER=gemini

# ─────────────────────────────────────────────
# META WHATSAPP CLOUD API
# Obtain from https://developers.facebook.com/
# ─────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac-verification
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id

# ─────────────────────────────────────────────
# CLOUDFLARE MULTI-KIOSK RELAY
# Outbound WebSocket — no inbound port required.
# Format: wss://relay.yourdomain.com/ws/{KIOSK_ID}
# ─────────────────────────────────────────────
RELAY_WS_URL=wss://relay.canectar.com/ws/CANEBOT-PUNE-04
RELAY_RECONNECT_INTERVAL_SECONDS=5

# ─────────────────────────────────────────────
# DOWNSTREAM ENTERPRISE TELEMETRY ENDPOINT
# ─────────────────────────────────────────────
DOWNSTREAM_REST_URL=https://api.canectar.com/v1/telemetry/chiller-attendance
OUTBOX_DRAIN_INTERVAL_SECONDS=30

# ─────────────────────────────────────────────
# BIOMETRICS & SECURITY (ISSUE-001)
# WARNING: Change BIOMETRIC_ENCRYPTION_KEY from default before production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────
FACE_MODEL_SOURCE=mobilefacenet_open
BIOMETRIC_ENCRYPTION_KEY=CHANGE_ME_generate_64_hex_chars_using_secrets_token_hex_32

# ─────────────────────────────────────────────
# MAIL ORGANIZER (if enabled)
# Token files are stored encrypted in .local_credentials/
# ─────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=.local_credentials/gmail_token.json
CALENDAR_CREDENTIALS_PATH=.local_credentials/calendar_token.json
GMAIL_SYNC_INTERVAL_SECONDS=60
MAIL_EXECUTION_MODE=assistive

# MCP SSE Endpoint � Public base URL (reverse-proxy deployments only)
# Leave empty for direct LAN deployments � URL derived from request automatically.
# ORCHESTRATOR_BASE_URL=https://kiosk.canectar.com
