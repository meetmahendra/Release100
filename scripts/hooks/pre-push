# GEES v3.1 Automated Pre-Push Gate Hook
set -e

echo "================================================================================"
echo "  [GIT-HOOK] Running Inviolable Pre-Flight Quality Gate before remote push..."
echo "================================================================================"

# Find Python interpreter (.venv or sys)
if [ -f ".venv/Scripts/python.exe" ]; then
    PYTHON_EXE=".venv/Scripts/python.exe"
elif [ -f ".venv/bin/python" ]; then
    PYTHON_EXE=".venv/bin/python"
else
    PYTHON_EXE="python"
fi

"$PYTHON_EXE" scripts/verify_all.py --quality-gate --fast
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "  [GIT-HOOK ERROR] Remote push ABORTED: Quality Gate breached."
    echo "  Fix all failing gates and ensure versions are bumped before pushing."
    echo "================================================================================"
    exit 1
fi

echo "================================================================================"
echo "  [GIT-HOOK SUCCESS] Quality Gate 100% verified. Proceeding with push."
echo "================================================================================"
exit 0
